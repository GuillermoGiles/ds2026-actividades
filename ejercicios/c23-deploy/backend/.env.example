# Desarrollo: copiar a .env. En producción estas variables NO van en un archivo:
# se cargan en el panel de Render (Environment).

NODE_ENV=development

# En Render la inyecta la plataforma: no hace falta cargarla.
PORT=3000

# Origen del frontend permitido por CORS (lista explícita, no "*").
# Prod: la URL exacta del Static Site, sin "/" al final.
FRONTEND_URL=http://localhost:5173

# Sólo para el Postgres de Docker (dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432

# Dev: el Postgres de Docker. Prod: la connection string DIRECTA (no pooled) de Neon, con ?sslmode=require
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

# Clave para firmar los JWT. Prod: la genera Render (botón "Generate"), nadie la escribe.
JWT_SECRET=cambiame_por_una_cadena_larga_y_aleatoria
