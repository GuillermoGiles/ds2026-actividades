# Imagen de PRODUCCIÓN (la buildea Render en cada push).
# El Dockerfile de desarrollo (C13) sigue siendo el que usa docker-compose.yml.

# Etapa 1: compilar
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx prisma generate && npm run build

# Etapa 2: correr (sin src/, sin tsx, sin tests: sólo dist/ y lo que Prisma necesita para migrar)
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma

# Sin ARG ni ENV con secretos: DATABASE_URL y JWT_SECRET entran al correr, desde el panel de Render.
# Si una migración falla, el CMD falla y Render deja corriendo la versión anterior.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
